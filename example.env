# Copy this file to `.env` and fill in the blanks. `.env` is loaded by
# docker compose for every service, and by the go-auth container via env_file.
# Anything marked REQUIRED panics on startup if left empty.

# ─── LDAP / Active Directory ──────────────────────────────────────────────────

# REQUIRED. Use ldap:// for plain or StartTLS, ldaps:// for implicit TLS.
LDAP_URL="ldap://ldap.example.com:389"

# REQUIRED. Base DN for the user search subtree.
LDAP_DN="DC=example,DC=com"

# Service account that binds before searching. Pass whichever form your
# directory accepts — none are auto-prefixed:
#   AD bare:      ldap_bind
#   AD UPN:       ldap_bind@example.com
#   AD NetBIOS:   EXAMPLE\ldap_bind
#   OpenLDAP DN:  CN=ldap_bind,OU=ServiceAccounts,DC=example,DC=com
LDAP_USER=ldap_bind
LDAP_PASSWORD=change-me

# Search filter — %s is replaced with the form input (already escaped).
# AD default below. For OpenLDAP try (uid=%s). For email-or-username:
#   LDAP_USER_FILTER=(|(sAMAccountName=%s)(mail=%s)(userPrincipalName=%s))
LDAP_USER_FILTER=(sAMAccountName=%s)

# Attributes pulled from the matching entry. `mail` falls back to
# <username>@<domain-from-base-dn> if the attribute is empty.
LDAP_EMAIL_ATTR=mail
LDAP_NAME_ATTR=displayName

# StartTLS upgrades a plain ldap:// connection to TLS (recommended on :389).
# Ignored for ldaps:// URLs.
LDAP_STARTTLS=true

# Skip cert verification — convenient on a self-signed internal CA, but
# disable in production once you trust the chain.
LDAP_TLS_SKIP_VERIFY=false

# ─── Overleaf bridge ──────────────────────────────────────────────────────────

# Internal URL of the sharelatex container. The default works under the
# bundled compose network; override only if you renamed the service.
OVERLEAF_INTERNAL_URL=http://sharelatex

# Admin account created via /launchpad on first boot. Required for the
# auto-provision flow that creates Overleaf users on first LDAP login.
OVERLEAF_ADMIN_EMAIL=admin@example.com
OVERLEAF_ADMIN_PASSWORD=change-me

# ─── Session ──────────────────────────────────────────────────────────────────

# REQUIRED. Minimum 32 bytes. Rotating this logs everyone out AND
# invalidates the HKDF-derived Overleaf passwords — next login transparently
# resets them via the admin endpoint, so rotation is safe but slow.
#   openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Optional. Set when fronting multiple subdomains with one cookie.
# COOKIE_DOMAIN=.example.com

# Defaults to true. Set false ONLY for local HTTP development; production
# must keep this on so the Secure flag is set on the session cookie.
COOKIE_SECURE=true

# ─── Misc ─────────────────────────────────────────────────────────────────────

# LISTEN_ADDR=:8080

# ─── File-based secrets (optional, recommended for prod) ──────────────────────
# Uncomment in docker-compose.yml's `secrets:` block and the matching
# environment overrides. When *_FILE is set it takes precedence over the
# inline value above, so you can leave the plaintext lines empty.
# LDAP_PASSWORD_FILE=/run/secrets/ldap_password
# OVERLEAF_ADMIN_PASSWORD_FILE=/run/secrets/overleaf_admin_password
# SESSION_SECRET_FILE=/run/secrets/session_secret
